### Example env for UAT (do NOT commit credentials to source control)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_USER=MAILTRAP_USER
EMAIL_PASS=MAILTRAP_PASS
EMAIL_PORT=2525
EMAIL_FROM=uat-inbox@example.com

### When true the server will use the incoming 'email' field as the destination address.
### Only set this in a controlled test environment.
ALLOW_TO_OVERRIDE=false

TARGET_URL=http://localhost:3000/api/sendCV
API_KEY=RahnWebsite
